# Global
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bogura_kothon

# Redis
REDIS_URL=redis://localhost:6379

# Security
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
ADMIN_IP_WHITELIST=127.0.0.1,::1
CSRF_SECRET=change_this_csrf_secret
TOTP_ISSUER=BoguraKothon

# Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=bn
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Admin Dashboard
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:5000/api/v1

# Backend
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Newsletter / Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=user@example.com
MAIL_PASS=app_password
MAIL_FROM="Bogura Kothon <news@bogurakothon.com>"
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=

# Search / Spam
AKISMET_API_KEY=
AKISMET_BLOG_URL=https://bogurakothon.com

# Deploy
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID_FRONTEND=
VERCEL_PROJECT_ID_ADMIN=
RAILWAY_TOKEN=
RAILWAY_SERVICE_ID=
RENDER_API_KEY=
RENDER_SERVICE_ID=

# GitHub automation
GH_TOKEN=
GH_OWNER=
GH_REPO=bogura-kothon
